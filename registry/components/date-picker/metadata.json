        "required": ["react-native-reanimated"],
        "optional": []
    },
    "features": [
        "Expandable in-place calendar interface",
        "Smooth layout transitions with Reanimated",
        "Date range constraints (min/max)",
        "Custom color theming",
        "Required field indicator",
        "Formatted date display"
    ],
    "props": [
        {
            "name": "value",
            "type": "Date | undefined",
            "required": false,
            "description": "Currently selected date"
        },
        {
            "name": "onDateChange",
            "type": "(date: Date) => void",
            "required": true,
            "description": "Callback when date selected"
        },
        {
            "name": "minimumDate",
            "type": "Date",
            "required": false,
            "description": "Earliest selectable date"
        },
        {
            "name": "maximumDate",
            "type": "Date",
            "required": false,
            "description": "Latest selectable date"
        },
        {
            "name": "label",
            "type": "string",
            "required": false,
            "description": "Label text above picker"
        },
        {
            "name": "required",
